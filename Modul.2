<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skyline Properties</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background-color:#f5f5f5;
        }

        header,footer{
            background-color:#0d6efd;
            color:white;
            text-align:center;
            padding:15px;
        }

        .property-card img{
            height:200px;
            object-fit:cover;
        }

        aside{
            background:white;
            padding:15px;
            border-radius:10px;
        }
    </style>
</head>

<body>

<!-- Header -->
<header>
    <h1>Skyline Properties</h1>

    <!-- Marquee -->
    <marquee>Welcome to Skyline Properties - Find Your Dream Home Today!</marquee>

    <!-- Internal Link -->
    <a href="#properties" class="text-white">Go to Properties</a> |
    
    <!-- External Link -->
    <a href="https://www.google.com" target="_blank" class="text-white">Visit Google</a> |
    
    <!-- Email Link -->
    <a href="mailto:skyline@gmail.com" class="text-white">Email Us</a>
</header>

<!-- Main Section -->
<section class="container mt-4">
    <div class="row">

        <!-- Sidebar -->
        <aside class="col-md-3">

            <h4>Filter Properties</h4>

            <!-- Price Dropdown -->
            <label>Price Range</label>
            <select class="form-select mb-3">
                <option>Below 50 Lakhs</option>
                <option>50 Lakhs - 1 Cr</option>
                <option>Above 1 Cr</option>
            </select>

            <!-- BHK Dropdown -->
            <label>BHK</label>
            <select class="form-select mb-3">
                <option>1 BHK</option>
                <option>2 BHK</option>
                <option>3 BHK</option>
            </select>

            <!-- Ordered List -->
            <h5>Why Choose Us?</h5>
            <ol>
                <li>Affordable Homes</li>
                <li>Best Locations</li>
                <li>Trusted Service</li>
            </ol>

            <!-- Unordered List -->
            <h5>Facilities</h5>
            <ul>
                <li>Parking</li>
                <li>Garden</li>
                <li>Security</li>
            </ul>

            <!-- Description List -->
            <dl>
                <dt>Apartment</dt>
                <dd>A modern flat for families.</dd>

                <dt>Villa</dt>
                <dd>Luxury independent house.</dd>
            </dl>

        </aside>

        <!-- Property Listings -->
        <section class="col-md-9" id="properties">

            <div class="row">

                <!-- Property 1 -->
                <article class="col-md-6 mb-4">
                    <div class="card property-card">

                        <img src="https://images.unsplash.com/photo-1568605114967-8130f3a36994"
                             class="card-img-top" alt="Property Image">

                        <div class="card-body">

                            <!-- Text Formatting -->
                            <h3><b>Luxury Apartment</b></h3>

                            <p>
                                <i>2 BHK</i> apartment with 
                                <u>modern facilities</u>.
                            </p>

                            <p><mark>Price: ₹75 Lakhs</mark></p>

                            <!-- Modal Button -->
                            <button class="btn btn-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#property1">
                                View Details
                            </button>
                        </div>
                    </div>
                </article>

                <!-- Property 2 -->
                <article class="col-md-6 mb-4">
                    <div class="card property-card">

                        <img src="https://images.unsplash.com/photo-1570129477492-45c003edd2be"
                             class="card-img-top" alt="Property Image">

                        <div class="card-body">

                            <h3><b>Modern Villa</b></h3>

                            <p>
                                <i>3 BHK</i> villa with 
                                <u>beautiful garden</u>.
                            </p>

                            <p><mark>Price: ₹1.2 Cr</mark></p>

                            <button class="btn btn-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#property2">
                                View Details
                            </button>
                        </div>
                    </div>
                </article>

            </div>
        </section>

    </div>
</section>

<!-- Modal 1 -->
<div class="modal fade" id="property1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4>Luxury Apartment</h4>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                Spacious 2 BHK apartment with parking, gym, and security.
            </div>

            <div class="modal-footer">
                <button class="btn btn-danger" data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Modal 2 -->
<div class="modal fade" id="property2">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4>Modern Villa</h4>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                Beautiful 3 BHK villa with garden, parking, and swimming pool.
            </div>

            <div class="modal-footer">
                <button class="btn btn-danger" data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Footer -->
<footer class="mt-4">
    <p>© 2026 Skyline Properties | All Rights Reserved</p>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
