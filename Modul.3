<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skyline Properties</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body{
            background-color:#f5f5f5;
        }

        .property-card img{
            height:220px;
            object-fit:cover;
        }

        footer{
            background:#212529;
            color:white;
            text-align:center;
            padding:15px;
        }
    </style>
</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">

        <a class="navbar-brand fw-bold" href="#">
            <i class="bi bi-buildings"></i> Skyline Properties
        </a>

        <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#">Properties</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#">Contact</a>
                </li>
            </ul>
        </div>

    </div>
</nav>

<!-- Header -->
<div class="container-fluid bg-primary text-white text-center py-5">
    <h1 class="fw-bold">Find Your Dream Home</h1>
    <p>Modern & Affordable Properties</p>

    <button class="btn btn-light">
        <i class="bi bi-search"></i> Explore Now
    </button>
</div>

<!-- Main Section -->
<div class="container my-5">

    <div class="row g-4">

        <!-- Sidebar -->
        <div class="col-lg-3 col-md-4">

            <div class="card shadow-sm p-3">

                <h4 class="mb-3">
                    <i class="bi bi-funnel-fill"></i> Filters
                </h4>

                <!-- Price Dropdown -->
                <div class="mb-3">
                    <label class="form-label">Price Range</label>

                    <select class="form-select">
                        <option>Select Price</option>
                        <option>Below 50 Lakhs</option>
                        <option>50 Lakhs - 1 Cr</option>
                        <option>Above 1 Cr</option>
                    </select>
                </div>

                <!-- BHK Dropdown -->
                <div class="mb-3">
                    <label class="form-label">BHK Type</label>

                    <select class="form-select">
                        <option>Select BHK</option>
                        <option>1 BHK</option>
                        <option>2 BHK</option>
                        <option>3 BHK</option>
                    </select>
                </div>

                <!-- Search Button -->
                <button class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Search
                </button>

            </div>

        </div>

        <!-- Property Listings -->
        <div class="col-lg-9 col-md-8">

            <div class="row g-4">

                <!-- Property Card 1 -->
                <div class="col-lg-6 col-md-12">

                    <div class="card property-card shadow-sm h-100">

                        <img src="https://images.unsplash.com/photo-1568605114967-8130f3a36994"
                        class="card-img-top"
                        alt="Property Image">

                        <div class="card-body">

                            <h4 class="card-title">
                                Luxury Apartment
                            </h4>

                            <p class="card-text">
                                <i class="bi bi-house-door"></i>
                                2 BHK Apartment with modern facilities.
                            </p>

                            <p class="text-success fw-bold">
                                ₹75 Lakhs
                            </p>

                            <button class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#property1">

                                View Details
                            </button>

                        </div>
                    </div>

                </div>

                <!-- Property Card 2 -->
                <div class="col-lg-6 col-md-12">

                    <div class="card property-card shadow-sm h-100">

                        <img src="https://images.unsplash.com/photo-1570129477492-45c003edd2be"
                        class="card-img-top"
                        alt="Property Image">

                        <div class="card-body">

                            <h4 class="card-title">
                                Modern Villa
                            </h4>

                            <p class="card-text">
                                <i class="bi bi-building"></i>
                                3 BHK Villa with garden & parking.
                            </p>

                            <p class="text-success fw-bold">
                                ₹1.2 Cr
                            </p>

                            <button class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#property2">

                                View Details
                            </button>

                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- Modal 1 -->
<div class="modal fade" id="property1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Luxury Apartment</h4>

                <button class="btn-close"
                data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <p><strong>Location:</strong> Nagpur</p>

                <p><strong>Facilities:</strong>
                Parking, Security, Gym</p>

                <p><strong>Price:</strong> ₹75 Lakhs</p>

            </div>

            <div class="modal-footer">
                <button class="btn btn-danger"
                data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Modal 2 -->
<div class="modal fade" id="property2">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Modern Villa</h4>

                <button class="btn-close"
                data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <p><strong>Location:</strong> Pune</p>

                <p><strong>Facilities:</strong>
                Garden, Parking, Swimming Pool</p>

                <p><strong>Price:</strong> ₹1.2 Cr</p>

            </div>

            <div class="modal-footer">
                <button class="btn btn-danger"
                data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Contact Form -->
<div class="container mb-5">

    <div class="card shadow-sm p-4">

        <h3 class="mb-4 text-center">
            Contact Us
        </h3>

        <form>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Full Name</label>

                    <input type="text"
                    class="form-control"
                    placeholder="Enter name">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>

                    <input type="email"
                    class="form-control"
                    placeholder="Enter email">
                </div>

            </div>

            <div class="mb-3">
                <label class="form-label">Message</label>

                <textarea class="form-control"
                rows="4"
                placeholder="Enter message"></textarea>
            </div>

            <button class="btn btn-success">
                <i class="bi bi-send"></i> Submit
            </button>

        </form>

    </div>

</div>

<!-- Footer -->
<footer>
    <p>
        <i class="bi bi-buildings"></i>
        © 2026 Skyline Properties | All Rights Reserved
    </p>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
