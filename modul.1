!DOCTYPE html>
<html>
<head>
    <title>Skyline Properties</title>
</head>

<body>

<!-- Header -->
<header>
    <h1>Skyline Properties</h1>

    <marquee>
        Welcome to Skyline Properties - Find Your Dream Home
    </marquee>

    <!-- Hyperlinks -->
    <a href="#properties">Go to Properties</a> |
    
    <a href="https://www.google.com" target="_blank">
        External Link
    </a> |
    
    <a href="mailto:skyline@gmail.com">
        Email Us
    </a>

    <hr>
</header>

<!-- Main Section -->
<section>

    <!-- Sidebar -->
    <aside>

        <h2>Filter Properties</h2>

        <!-- Price Dropdown -->
        <label>Price Range:</label>

        <select>
            <option>Below 50 Lakhs</option>
            <option>50 Lakhs - 1 Cr</option>
            <option>Above 1 Cr</option>
        </select>

        <br><br>

        <!-- BHK Dropdown -->
        <label>BHK Type:</label>

        <select>
            <option>1 BHK</option>
            <option>2 BHK</option>
            <option>3 BHK</option>
        </select>

        <hr>

        <!-- Ordered List -->
        <h3>Why Choose Us?</h3>

        <ol>
            <li>Affordable Prices</li>
            <li>Best Locations</li>
            <li>Trusted Service</li>
        </ol>

        <!-- Unordered List -->
        <h3>Facilities</h3>

        <ul>
            <li>Parking</li>
            <li>Garden</li>
            <li>Security</li>
        </ul>

        <!-- Description List -->
        <h3>Property Types</h3>

        <dl>
            <dt>Apartment</dt>
            <dd>Modern family flat</dd>

            <dt>Villa</dt>
            <dd>Luxury independent house</dd>
        </dl>

    </aside>

    <hr>

    <!-- Property Listings -->
    <section id="properties">

        <!-- Property 1 -->
        <article>

            <h2><b>Luxury Apartment</b></h2>

            <!-- Image -->
            <img src="https://images.unsplash.com/photo-1568605114967-8130f3a36994"
                 width="300"
                 height="200"
                 alt="Apartment Image">

            <!-- Text Formatting -->
            <p>
                <i>2 BHK</i> apartment with 
                <u>modern facilities</u>.
            </p>

            <p>
                <mark>Price: ₹75 Lakhs</mark>
            </p>

            <!-- Details -->
            <details>
                <summary>View Details</summary>

                <p>Location: Nagpur</p>
                <p>Parking Available</p>
                <p>24x7 Security</p>
            </details>

        </article>

        <hr>

        <!-- Property 2 -->
        <article>

            <h2><b>Modern Villa</b></h2>

            <img src="https://images.unsplash.com/photo-1570129477492-45c003edd2be"
                 width="300"
                 height="200"
                 alt="Villa Image">

            <p>
                <i>3 BHK</i> villa with 
                <u>beautiful garden</u>.
            </p>

            <p>
                <mark>Price: ₹1.2 Cr</mark>
            </p>

            <details>
                <summary>View Details</summary>

                <p>Location: Pune</p>
                <p>Swimming Pool</p>
                <p>Garden Area</p>
            </details>

        </article>

    </section>

</section>

<hr>

<!-- Footer -->
<footer>

    <p>
        © 2026 Skyline Properties | All Rights Reserved
    </p>

</footer>

</body>
</html>
